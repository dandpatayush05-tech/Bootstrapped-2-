# ── Server ────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT Secrets (REQUIRED in production) ──────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Redis (for rate limiter) ──────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
